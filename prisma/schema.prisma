generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MODERADOR
  USUARIO

  @@map("user_role")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED

  @@map("order_status")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      UserRole @default(USUARIO)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

model Store {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(160)
  whatsapp  String   @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  categories    Category[]
  products      Product[]
  deliveryAreas DeliveryArea[]
  orders        Order[]
  paymentMethods PaymentMethod[]

  @@map("stores")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(120)
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productCategories ProductCategory[]

  @@unique([storeId, slug])
  @@map("categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  name        String   @db.VarChar(180)
  description String?
  brand       String?  @db.VarChar(120)
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categories ProductCategory[]
  variants   ProductVariant[]

  @@index([storeId, active])
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  sku                String   @db.VarChar(80)
  size               String?  @db.VarChar(80)
  flavor             String?  @db.VarChar(100)
  price              Decimal  @db.Decimal(12, 2)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  stockQuantity      Int?     @map("stock_quantity")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@map("product_variants")
}

model DeliveryArea {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  city         String   @db.VarChar(120)
  state        String   @db.Char(2)
  neighborhood String   @db.VarChar(120)
  shippingFee  Decimal  @map("shipping_fee") @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, city, state, neighborhood])
  @@map("delivery_areas")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String      @map("store_id") @db.Uuid
  orderNsu       String      @unique @map("order_nsu") @db.VarChar(100)
  status         OrderStatus @default(PENDING)
  amount         Int
  customerName   String?     @map("customer_name") @db.VarChar(150)
  whatsapp       String?     @db.VarChar(20)
  paymentMethodId String?    @map("payment_method_id") @db.Uuid
  deliveryFee    Int         @default(0) @map("delivery_fee")
  deliveryFeePending Boolean @default(false) @map("delivery_fee_pending")
  cashReceived   Int?        @map("cash_received")
  cep            String?     @db.VarChar(9)
  street         String      @db.VarChar(200)
  number         String      @db.VarChar(30)
  neighborhood   String      @db.VarChar(120)
  city           String      @db.VarChar(120)
  state          String      @db.Char(2)
  complement     String?     @db.VarChar(120)
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  store  Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  items  OrderItem[]

  @@index([storeId, status, createdAt])
  @@map("orders")
}

model PaymentMethod {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String   @db.VarChar(80)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders    Order[]
  acceptedCards AcceptedCard[]

  @@unique([storeId, name])
  @@map("payment_methods")
}

model AcceptedCard {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentMethodId String        @map("payment_method_id") @db.Uuid
  name            String        @db.VarChar(80)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([paymentMethodId, name])
  @@map("accepted_cards")
}

model OrderItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  variantId    String  @map("variant_id") @db.Uuid
  productName  String  @map("product_name") @db.VarChar(180)
  variantLabel String? @map("variant_label") @db.VarChar(180)
  sku          String  @db.VarChar(80)
  quantity     Int
  unitPrice    Int     @map("unit_price")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}
